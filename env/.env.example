# Key 申请链接（env/README.md 有完整表）：
#  OpenAI: https://platform.openai.com/api-keys
#  Gemini: https://aistudio.google.com/app/apikey
#  聚合: https://fal.ai ｜ https://openrouter.ai
#  火山TTS: https://console.volcengine.com/ark ｜ Azure: portal.azure.com
# env/.env.example —— 复制为 .env 后填写（.env 不入库）
HF_ENDPOINT=https://hf-mirror.com

# TTS 后端
TTS_PROVIDER=cosyvoice        # cosyvoice | volcengine | azure | elevenlabs
TTS_API_KEY=

# 3D（按需）
TRIPO_API_KEY=
MESHY_API_KEY=

# 生图云后端（可选）
IMAGE_API=comfyui        # comfyui | fal | replicate | openai
OPENAI_API_KEY=        # 可选：gpt-image 后端（国内需中转）

GEMINI_API_KEY=        # 可选：Nano Banana 后端（ComfyUI 节点用；国内可走 fal/中转）
