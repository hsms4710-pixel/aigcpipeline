# env/.env.example —— 复制为 .env 后填写（.env 不入库）
# 详细说明见 env/README.md；Key 申请链接见 env/key-access.md

# ---- 生图/LLM 中转站（OpenAI 兼容，项目实际使用）----
GPT_API_KEY=sk-xxx
GPT_BASE_URL=https://api.sisct2.xyz/v1
GPT_MODEL=gpt-5.5

# ---- 视觉验收/视觉提示词（vision_gate / prompt_vision / vision_review 读取）----
VISION_KEY=sk-xxx

# ---- 3D（按需，Tripo 试用额度有限）----
TRIPO_API_KEY=tcli_xxx
MESHY_API_KEY=

# ---- 语音 TTS（按需）----
TTS_PROVIDER=cosyvoice        # cosyvoice | volcengine | azure | elevenlabs
TTS_API_KEY=
VOLC_API_KEY=

# ---- 视频/生图备选（按需）----
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
IMAGE_API=comfyui             # comfyui | fal | replicate | openai

# ---- 国内下载 HF 模型镜像（必填，否则模型下载慢/失败）----
HF_ENDPOINT=https://hf-mirror.com
