# env/config.toml.example —— 复制为 config.toml 后填写真实 key（config.toml 不入库）
# 参照 OpenClaw config.toml 格式（LLM/审阅/Agent 框架共用）；MCP 不在此文件，用 `openclaw mcp add` 或 codex mcp add
model_provider = "OpenAI"
model = "gpt-5.5"
review_model = "gpt-5.5"
model_reasoning_effort = "xhigh"
disable_response_storage = true
network_access = "enabled"
windows_wsl_setup_acknowledged = true

[model_providers.OpenAI]
name = "OpenAI"
base_url = "https://api.sisct2.xyz/v1"   # 中转站，可替换
wire_api = "responses"
requires_openai_auth = true
api_key = "sk-xxx"                        # 填真实 key

[features]
goals = true
